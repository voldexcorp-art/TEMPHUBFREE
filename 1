                reachPart.Size = arm.Size + Vector3.new(REACH_SIZE, REACH_SIZE, REACH_SIZE)
                reachPart.Transparency = REACH_VISIBLE and REACH_TRANSPARENCY or 1
            end
        else
            cleanReach()
        end
    end)
